APP_NAME=Botmind AI Backend
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/botmind
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=replace-with-a-long-random-secret
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Must match your embedder output size and Postgres init (defaults work with Ollama nomic-embed-text)
EMBEDDING_DIMENSIONS=768
